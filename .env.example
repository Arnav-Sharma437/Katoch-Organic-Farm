# MongoDB
MONGODB_URI=

# Admin (accounts live in MongoDB; create with: npm run create-admin -- <username> <password> [email])
JWT_SECRET=
# Optional: migrate first admin from env when the database has no admins yet
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Resend — required for inbox email when someone uses the contact form
# https://resend.com — create API key, add/verify sending domain (or use Resend onboarding rules).
RESEND_API_KEY=
# Verified sender, e.g. noreply@yourdomain.com
RESEND_FROM_EMAIL=
# Where YOU receive "new message" alerts (comma-separated allowed)
RESEND_TO_EMAIL=

# Optional
NEXT_PUBLIC_APP_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
